# Solo se publican el menú y los juegos.
# Todo lo demás (apps de negocio, configuración local) queda fuera.
/*

# Menú principal
!/index.html
!/manifest.webmanifest
!/sw.js
!/icons/
!/README.md
!/.gitignore
!/.nojekyll

# Juegos de un solo archivo
!/tetris.html
!/loteria.html
!/logica.html
!/matematicas.html

# Juegos en carpeta
!/bloque-diario/
!/lluvia-letras/
!/banda-colores/
!/rebote-cromatico/

# Demo para clientes (no va en el menú; se arma con «node calendario-hotel/scripts/build-demo.mjs»)
!/demo-hotel/

# Herramientas
!/qr-studio/
!/esfera360/
# Código fuente de Esfera360 (se compila con «npm run build» hacia /esfera360/)
!/esfera360-src/
/esfera360-src/node_modules/
